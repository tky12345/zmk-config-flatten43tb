#define ZMK_POINTING_DEFAULT_SCRL_VAL 150

#include <behaviors/rgbled_widget.dtsi>
#include <dt-bindings/zmk/input_transform.h>
#include <input/processors.dtsi>
#include <zephyr/dt-bindings/input/input-event-codes.h>
#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/pointing.h>

&mt {
    flavor = "tap-preferred";
    quick-tap-ms = <50>;
};

&mmv {
    delay-ms = <20>;
    trigger-period-ms = <5>;
    time-to-max-speed-ms = <100>;
    acceleration-exponent = <2>;
};

&msc {
    delay-ms = <3>;
    trigger-period-ms = <3>;
    time-to-max-speed-ms = <100>;
    acceleration-exponent = <0>;
};

/ {
    input_processors {
        zip_wheel_scaler: zip_wheel_scaler {
            compatible = "zmk,input-processor-scaler";
            #input-processor-cells = <2>;
            type = <INPUT_EV_REL>;
            codes = <INPUT_REL_WHEEL>;
            track-remainders;
        };
    };
};

/ {
    combos {
        compatible = "zmk,combos";

        tab {
            bindings = <&kp TAB>;
            key-positions = <11 12>;
            require-prior-idle-ms = <10>;
            timeout-ms = <40>;
            slow-release;
        };

        Escape {
            bindings = <&kp ESCAPE>;
            key-positions = <1 2>;
            timeout-ms = <40>;
        };

        ro {
            bindings = <&kp INT_RO>;
            key-positions = <31 32>;
            timeout-ms = <50>;
            require-prior-idle-ms = <10>;
            slow-release;
        };

        attomark {
            bindings = <&kp LEFT_BRACKET>;
            key-positions = <7 8>;
        };

        left_click {
            bindings = <&mkp MB1>;
            key-positions = <19 20>;
            timeout-ms = <40>;
            slow-release;
        };

        right_click {
            bindings = <&mkp MB2>;
            key-positions = <20 21>;
            slow-release;
            timeout-ms = <40>;
        };

        f {
            bindings = <&kp RIGHT_BRACKET>;
            key-positions = <7 19>;
            slow-release;
        };

        g {
            bindings = <&kp BACKSLASH>;
            key-positions = <8 20>;
            slow-release;
        };
    };

    macros {
        to_layer_0: to_layer_0 {
            compatible = "zmk,behavior-macro-one-param";
            #binding-cells = <1>;
            bindings = <&to 0 &macro_param_1to1 &kp MACRO_PLACEHOLDER>;
            label = "TO_LAYER_0";
        };

        mic_mute: mic_mute {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&none>;
            label = "MIC_MUTE";
        };

        // Altとレイヤー5を同時に押し下げるマクロ

        alt_layer_on: alt_layer_on {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            wait-ms = <0>;
            tap-ms = <0>;
            bindings =
                <&macro_press>,
                <&kp LALT &tog 5>,
                <&macro_pause_for_release>,
                <&macro_release>,
                <&kp LALT &tog 5>;
        };

        macro_alt_tab: macro_alt_tab {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp LALT &kp TAB>;
            label = "MACRO_ALT_TAB";
        };
    };

    behaviors {
        lt_to_layer_0: lt_to_layer_0 {
            compatible = "zmk,behavior-hold-tap";
            label = "LAYER_TAP_TO_0";
            bindings = <&mo>, <&to_layer_0>;

            #binding-cells = <2>;
            tapping-term-ms = <220>;
        };

        sensor_rotate_kp: sensor_rotate_kp {
            compatible = "zmk,behavior-sensor-rotate-var";
            #sensor-binding-cells = <2>;
            bindings = <&kp>, <&kp>;
        };

        mouse_wheel_scroll: mouse_wheel_scroll {
            compatible = "zmk,behavior-sensor-rotate-var";
            #sensor-binding-cells = <2>;
            bindings = <&msc>, <&msc>;

            tap-ms = <20>;
        };

        // 親指用：ホールドで上記マクロ（Alt押し+Layer5）、タップでTAB

        alt_tab_hold: alt_tab_hold {
            compatible = "zmk,behavior-hold-tap";
            label = "ALT_TAB_HOLD";
            #binding-cells = <2>;
            tapping-term-ms = <200>;
            flavor = "hold-preferred";

            // 1つ目(Hold)にマクロ、2つ目(Tap)に通常のキー

            bindings = <&macro_alt_tab>, <&kp>;
        };

        a_win: a_win {
            compatible = "zmk,behavior-hold-tap";
            label = "A_WIN";
            bindings = <&kp>, <&kp>;

            #binding-cells = <2>;
            tapping-term-ms = <200>;
            flavor = "tap-preferred";
            quick-tap-ms = <160>;
            require-prior-idle-ms = <10>;
            hold-trigger-on-release;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        default_layer {
            bindings = <
&lt 6 Q            &kp W         &kp E         &kp R               &kp T                                                          &kp Y        &kp U        &kp I      &kp O    &kp P
&a_win LEFT_WIN A  &kp S         &kp D         &mt LCTRL F         &kp G        &kp A                            &kp SEMI         &kp H        &mt RCTRL J  &kp K      &lt 5 L  &mt RIGHT_ALT MINUS
&mt LEFT_SHIFT Z   &kp X         &lt 5 C       &lt 4 V             &kp B        &lt 4 LG(LA(K))                  &kp APOS         &kp N        &kp M        &kp COMMA  &kp DOT  &mt RIGHT_SHIFT SLASH
&kp LCTRL          &kp LEFT_WIN  &kp LEFT_ALT  &lt 3 INT_MUHENKAN  &lt 2 SPACE  &lt_to_layer_0 1 INT_HENKAN      &lt 3 BACKSPACE  &lt 1 ENTER                                   &kp BACKSPACE
            >;

            sensor-bindings = <&sensor_rotate_kp C_VOL_UP C_VOL_DN>;
        };

        ARROW {
            bindings = <
&kp GRAVE  &trans  &trans  &trans  &trans                                &kp HOME  &kp PAGE_UP  &kp UP_ARROW    &kp PAGE_DOWN  &trans
&trans     &trans  &trans  &trans  &trans            &trans      &trans  &kp END   &kp LEFT     &kp DOWN_ARROW  &kp RIGHT      &kp EQUAL
&trans     &trans  &trans  &trans  &trans            &trans      &trans  &kp SEMI  &kp APOS     &kp RBKT        &kp BSLH       &kp INT3
&trans     &trans  &trans  &trans  &kp INT_MUHENKAN  &trans      &trans  &trans                                                &kp DELETE
            >;

            sensor-bindings = <&inc_dec_kp 0 0>;
        };

        FUNC {
            bindings = <
&kp F11            &kp F12  &trans  &trans        &trans                             &kp KP_PLUS       &kp N7              &kp N8  &kp N9  &kp MINUS
&kp F1             &kp F2   &kp F3  &mt LCTRL F4  &kp F5   &trans            &trans  &kp KP_ASTERISK   &mt RCTRL NUMBER_4  &kp N5  &kp N6  &kp FSLH
&mt LEFT_SHIFT F6  &kp F7   &kp F8  &kp F9        &kp F10  &kp LEFT_WIN      &trans  &kp LS(MINUS)     &kp N1              &kp N2  &kp N3  &mt RIGHT_SHIFT DOT
&trans             &trans   &trans  &trans        &trans   &trans            &trans  &lt 1 INT_HENKAN                                      &kp BACKSPACE
            >;

            sensor-bindings = <&sensor_rotate_kp C_VOLUME_DOWN C_VOLUME_UP>;
        };

        NUMBER {
            bindings = <
&kp F11            &kp F12              &trans  &trans        &trans                             &kp KP_PLUS      &kp N7              &kp N8  &kp N9  &kp MINUS
&trans             &alt_tab_hold 0 TAB  &trans  &mt LCTRL F4  &kp F5   &trans            &trans  &kp KP_ASTERISK  &mt RCTRL NUMBER_4  &kp N5  &kp N6  &kp FSLH
&mt LEFT_SHIFT F6  &kp F7               &kp F8  &kp F9        &kp F10  &kp LEFT_WIN      &trans  &kp LS(MINUS)    &kp N1              &kp N2  &kp N3  &mt RIGHT_SHIFT DOT
&trans             &trans               &trans  &trans        &trans   &trans            &trans  &lt 1 N0                                             &kp BACKSPACE
            >;

            sensor-bindings = <&sensor_rotate_kp C_VOLUME_DOWN C_VOLUME_UP>;
        };

        MOUSE {
            bindings = <
&trans  &trans  &trans  &trans  &trans                      &trans  &trans    &trans    &trans    &trans
&trans  &trans  &trans  &trans  &trans  &trans      &trans  &trans  &mkp MB1  &mkp MB3  &mkp MB2  &trans
&trans  &trans  &trans  &trans  &trans  &trans      &trans  &trans  &mkp MB4  &mkp MB5  &trans    &trans
&trans  &trans  &trans  &trans  &trans  &trans      &trans  &trans                                &trans
            >;
        };

        SCROLL {
            bindings = <
&trans  &trans       &trans  &trans        &trans                            &trans  &trans    &trans    &trans  &trans
&trans  &kp LA(TAB)  &trans  &trans        &trans        &trans      &trans  &trans  &mkp MB4  &mkp MB5  &trans  &trans
&trans  &trans       &trans  &trans        &trans        &trans      &trans  &trans  &trans    &trans    &trans  &trans
&trans  &trans       &trans  &kp LEFT_ALT  &kp LEFT_ALT  &trans      &trans  &trans                              &trans
            >;
        };

        layer_6 {
            bindings = <
&trans  &trans        &trans        &trans        &trans                               &bt BT_SEL 0  &bt BT_SEL 1  &bt BT_SEL 2  &bt BT_SEL 3  &bt BT_SEL 4
&trans  &trans        &trans        &trans        &trans    &trans        &trans       &trans        &trans        &trans        &trans        &trans
&trans  &kp NUMBER_1  &kp NUMBER_2  &kp NUMBER_3  &ind_con  &ind_bat      &bootloader  &trans        &trans        &trans        &trans        &bt BT_CLR
&trans  &trans        &trans        &trans        &trans    &trans        &trans       &trans                                                  &bt BT_CLR_ALL
            >;
        };
    };
};
